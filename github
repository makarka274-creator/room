}

// РАСТЕНИЯ

function plant(parent,x,y,z,s=1){
 const g=group(parent,x,y,z);
 g.scale.setScalar(s);
 cyl(g,0,.12,0,.12,.15,.24,M.woodLight);
 for(let i=0;i<7;i++){
  const a=i*Math.PI*2/7;
  const leaf=ball(g,Math.cos(a)*.15,.35+(i%3)*.06,
                  Math.sin(a)*.12,.08,.22,.06,M.leaf);
  leaf.rotation.z=-Math.cos(a)*.5;
  leaf.rotation.x=Math.sin(a)*.4;
 }
}

