box(closet,.38,3.78,.35,.035,1.58,.035,M.grey);

for(const x of [-.56,.56]){
 cyl(closet,x,3.78,.39,.025,.025,.10,M.metal,12);
}

box(closet,0,4.63,0,1.62,.12,.65,M.woodLight);
strip(closet,0,4.53,.37,1.42,.025,.025,'#8b56ff');

// ОТКРЫТАЯ СТОЙКА С ОДЕЖДОЙ

const rack=group(upper,-1.45,0,-3.12);
box(rack,0,4.52,0,2.05,.10,.52,M.woodLight);
box(rack,0,3.04,0,2.05,.10,.52,M.woodLight);

for(const x of [-.96,.96]){
 box(rack,x,3.78,0,.07,1.50,.07,M.metal);
 cyl(rack,x,4.42,0,.045,.045,.07,M.metal,12);
}

cyl(rack,0,4.35,0,.035,.035,1.92,M.metal,16);

const clothes=[
 {x:-.78,c:'#9d8be8',w:.27},
 {x:-.47,c:'#e5dff3',w:.30},
 {x:-.13,c:'#566baf',w:.31},
 {x:.22,c:'#c38bc9',w:.28},
 {x:.54,c:'#b9bfdc',w:.30},
 {x:.82,c:'#514b78',w:.24}
];

for(const item of clothes){
 const cg=group(rack,item.x,0,.015);
 const cloth=mat(item.c,.75,'#7040ff',.08);

 // Вешалка
 cyl(cg,0,4.29,0,.012,.012,.10,M.metal,8);
 const hangerL=box(cg,-.07,4.24,0,.16,.018,.018,M.metal,false);
 hangerL.rotation.z=-.24;
 const hangerR=box(cg,.07,4.24,0,.16,.018,.018,M.metal,false);
 hangerR.rotation.z=.24;

 // Верх одежды и две штанины
 box(cg,0,3.91,0,item.w,.42,.075,cloth);
 box(cg,-item.w*.22,3.60,0,item.w*.38,.28,.08,cloth);
 box(cg,item.w*.22,3.60,0,item.w*.38,.28,.08,cloth);

 box(cg,0,4.11,.043,item.w*.62,.025,.012,
     mat('#e8e2ff',.7));
}

// КОМОД ДЛЯ АКСЕССУАРОВ

const dresser=group(upper,.35,0,-3.05);
box(dresser,0,3.25,0,1.25,.68,.66,M.woodLight);
box(dresser,0,3.60,.34,1.19,.08,.68,M.white);

for(const y of [3.14,3.36]){
 box(dresser,0,y,.34,1.13,.18,.035,M.white);
 cyl(dresser,0,y,.39,.025,.025,.035,M.metal,10);
}

// Флаконы и аксессуары
box(dresser,-.32,3.72,.02,.13,.17,.12,M.pink);
box(dresser,-.32,3.81,.02,.07,.04,.07,M.glow);
box(dresser,.02,3.70,.02,.16,.13,.12,M.blue);
cyl(dresser,.35,3.73,.02,.07,.07,.16,M.glow,16);

// ЗЕРКАЛО В ПОЛНЫЙ РОСТ

const mirror=group(upper,1.00,0,-2.25);
box(mirror,0,3.80,0,.08,1.72,1.05,M.woodLight);
box(mirror,-.048,3.80,0,.025,1.60,.92,
    mat('#5d6c9d',.22,'#3b4caa',.22));
strip(mirror,-.07,3.80,0,.025,1.67,.98,'#8b56ff');

// Пуфик перед зеркалом
ball(upper,.42,3.00,-1.65,.35,.22,.34,M.pink);
ball(upper,.42,3.17,-1.65,.29,.10,.28,M.fabric2);

// ПОЛКИ ДЛЯ СУМОК И КОРОБОК

const shelves=group(upper,-4.10,0,-1.35);

for(const y of [3.25,3.72,4.19]){
 box(shelves,0,y,0,.48,.07,1.65,M.woodLight);
 strip(shelves,.24,y-.08,0,.025,.025,1.52,
       y===3.72?'#536dff':'#8b56ff');
}

const bagColors=['#9a83d7','#6e7db7','#c995c9'];

for(let i=0;i<3;i++){
 box(shelves,-.08,3.48,-.48+i*.48,.29,.32,.35,
     mat(bagColors[i]));
 box(shelves,-.08,3.68,-.48+i*.48,.15,.035,.16,M.metal);
}

// КОВРИК ГАРДЕРОБНОЙ
box(upper,-1.45,2.925,-1.35,2.25,.025,1.05,
    mat('#bcb0e4',.95,'#6944b6',.10),false);

// Потолочная линия света гардеробной
strip(upper,-1.7,4.70,-3.73,4.65,.025,.025,'#8b56ff');

const loftLight=new THREE.PointLight('#9b70ff',7,6);
loftLight.position.set(-1.6,4.35,-2.0);
scene.add(loftLight);

const closetBlueLight=new THREE.PointLight('#526eff',5,5);
closetBlueLight.position.set(-3.9,4.1,-1.2);
scene.add(closetBlueLight);

// ЛЕСТНИЦА С ПОДСВЕТКОЙ

const stairs=group(room,-.20,0,0);
const stairCount=11;

for(let i=0;i<stairCount;i++){
 const y=.20+i*.225;
 const z=2.55-i*.235;

 box(stairs,0,y,z,.82,.16,.31,M.woodLight);

 strip(stairs,0,y+.075,z-.13,.76,.025,.025,
       i%2===0?'#8b56ff':'#536dff');
}

// Опоры и поручни
for(const side of [-.48,.48]){
 for(let i=0;i<=6;i++){
  const t=i/6;
  const y=.43+t*2.05;
  const z=2.55-t*2.55;
  box(stairs,side,y,z,.055,.10,.055,M.white);
 }

 const rail=box(stairs,side,1.50,1.28,.075,2.35,.075,M.woodLight);
 rail.rotation.x=-Math.atan2(2.05,2.55);
}

// Площадка у выхода на второй этаж
box(upper,-.20,2.83,.03,1.05,.12,.48,M.woodLight);

// ПАНЕЛЬ УПРАВЛЕНИЯ

const panel=document.querySelector('.panel');
const toggle=document.querySelector('#toggle');

toggle.addEventListener('click',()=>{
 const collapsed=panel.classList.toggle('collapsed');
 toggle.classList.toggle('open',!collapsed);
 toggle.textContent=collapsed?'›':'‹';
});

function setCamera(position,target){
 camera.position.copy(position);
 controls.target.copy(target);
 controls.update();
}

document.querySelectorAll('[data-view]').forEach(button=>{
 button.addEventListener('click',()=>{
  document.querySelectorAll('[data-view]').forEach(b=>
   b.classList.remove('active')
  );
  button.classList.add('active');

  const view=button.dataset.view;

  if(view==='room'){
   setCamera(initialCamera,initialTarget);
  }

  if(view==='closet'){
   setCamera(
    new THREE.Vector3(7.5,9.5,10),
    new THREE.Vector3(-1.65,3.45,-1.7)
   );
  }

  if(view==='front'){
   setCamera(
    new THREE.Vector3(0,7,16),
    new THREE.Vector3(0,2,0)
   );
  }
 });
});

// Скрытие стен
let wallsHidden=false;

document.querySelector('#wallsBtn').addEventListener('click',()=>{
 wallsHidden=!wallsHidden;
 walls.visible=!wallsHidden;
 document.querySelector('#wallsBtn').innerHTML=
  `<span class="dot"></span>${wallsHidden?'Показать стены':'Скрыть стены'}`;
});

// Неон
let lightsOn=true;

document.querySelector('#neonBtn').addEventListener('click',()=>{
 lightsOn=!lightsOn;
 neonGroup.visible=lightsOn;

 purpleLight.intensity=lightsOn?30:0;
 blueLight.intensity=lightsOn?15:0;
 pinkLight.intensity=lightsOn?8:0;
 lampLight.intensity=lightsOn?5:0;
 loftLight.intensity=lightsOn?7:0;
 closetBlueLight.intensity=lightsOn?5:0;

 monitorGlow.intensity=lightsOn?22:12;
 monitorPurpleGlow.intensity=lightsOn?10:4;

 document.querySelector('#neonBtn').innerHTML=
  `<span class="dot"></span>Неон: ${lightsOn?'ON':'OFF'}`;
});

// Ночной режим
let night=true;

document.querySelector('#nightBtn').addEventListener('click',()=>{
 night=!night;
 scene.background.set(night?'#090a16':'#17172d');
 scene.fog.color.set(night?'#090a16':'#17172d');
 mainLight.intensity=night?.4:.85;
 renderer.toneMappingExposure=night?1:1.1;
});

// Сброс камеры
document.querySelector('#resetBtn').addEventListener('click',()=>{
 setCamera(initialCamera,initialTarget);
});

// Размер экрана
window.addEventListener('resize',()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});

// АНИМАЦИЯ
function animate(){
 requestAnimationFrame(animate);

 const t=performance.now()*.001;

 if(lightsOn){
  purpleLight.intensity=30+Math.sin(t*1.3)*2;
  blueLight.intensity=15+Math.sin(t*1.1+1)*1.5;
 }

 controls.update();
 renderer.render(scene,camera);
}

animate();
</script>
</body>
</html>
