// ШКАФ НА ПЕРВОМ ЭТАЖЕ

const wardrobe=group(room,-4.15,0,1.65);
box(wardrobe,0,1.55,0,1.3,3.1,1.35,M.white);
box(wardrobe,-.32,1.55,.69,.61,2.95,.035,M.woodLight);
box(wardrobe,.32,1.55,.69,.61,2.95,.035,M.woodLight);
box(wardrobe,0,1.55,.715,.025,2.95,.025,M.grey);

for(const x of [-.12,.12]){
