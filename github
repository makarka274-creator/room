<script type="module">
import * as THREE from 'three';
import {OrbitControls} from 'three/addons/controls/OrbitControls.js';

const scene=new THREE.Scene();
scene.background=new THREE.Color('#090a16');
scene.fog=new THREE.Fog('#090a16',18,35);

const camera=new THREE.PerspectiveCamera(38,innerWidth/innerHeight,.1,100);
camera.position.set(12,10,13);

const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.outputColorSpace=THREE.SRGBColorSpace;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1;
document.querySelector('#scene').appendChild(renderer.domElement);

const controls=new OrbitControls(camera,renderer.domElement);
controls.target.set(0,2,0);
controls.enableDamping=true;
controls.dampingFactor=.06;
controls.minDistance=6;
controls.maxDistance=24;
controls.maxPolarAngle=Math.PI*.49;
controls.mouseButtons={
 LEFT:THREE.MOUSE.ROTATE,
 MIDDLE:THREE.MOUSE.DOLLY,
 RIGHT:THREE.MOUSE.PAN
};

const initialCamera=new THREE.Vector3(12,10,13);
const initialTarget=new THREE.Vector3(0,2,0);

function mat(color,rough=.8,emissive='#000000',power=0){
 return new THREE.MeshStandardMaterial({
  color,roughness:rough,emissive,emissiveIntensity:power
 });
}

const M={
 white:mat('#f2effb'),
 wall:mat('#eeecf8'),
 side:mat('#d9d6e9'),
 floor:mat('#bdb5d5'),
 wood:mat('#b9a5d0'),
 woodLight:mat('#e1d7ec'),
 violet:mat('#8051e8',.5,'#7040ff',.6),
 deep:mat('#302640'),
 blue:mat('#879cff',.5,'#526eff',.5),
 pink:mat('#dca4d7',.6,'#a94cb9',.3),
 grey:mat('#aaa7c0'),
 fabric:mat('#b7a9d4'),
 fabric2:mat('#d6cbe8'),
 black:mat('#29283b'),
 metal:mat('#8585a4',.35),
 leaf:mat('#658d7c'),
 glow:mat('#e6e0ff',.3,'#a38bff',.6)
};

const room=new THREE.Group();
scene.add(room);

const walls=new THREE.Group();
room.add(walls);

const neonGroup=new THREE.Group();
room.add(neonGroup);

function box(parent,x,y,z,sx,sy,sz,material,cast=true){
 const mesh=new THREE.Mesh(
  new THREE.BoxGeometry(sx,sy,sz),material
 );
 mesh.position.set(x,y,z);
 mesh.castShadow=cast;
 mesh.receiveShadow=true;
 parent.add(mesh);
 return mesh;
}

function ball(parent,x,y,z,sx,sy,sz,material){
 const mesh=new THREE.Mesh(
  new THREE.SphereGeometry(1,18,12),material
 );
 mesh.position.set(x,y,z);
 mesh.scale.set(sx,sy,sz);
 mesh.castShadow=true;
 mesh.receiveShadow=true;
 parent.add(mesh);
 return mesh;
}

function cyl(parent,x,y,z,r1,r2,h,material,n=20){
 const mesh=new THREE.Mesh(
  new THREE.CylinderGeometry(r1,r2,h,n),material
 );
 mesh.position.set(x,y,z);
 mesh.castShadow=true;
 mesh.receiveShadow=true;
 parent.add(mesh);
 return mesh;
}

function group(parent,x=0,y=0,z=0){
 const g=new THREE.Group();
 g.position.set(x,y,z);
 parent.add(g);
 return g;
}

function strip(parent,x,y,z,sx,sy,sz,color){
 const m=mat(color,.3,color,1);
 const mesh=box(parent,x,y,z,sx,sy,sz,m,false);
 neonGroup.add(mesh);
 return mesh;
}

// ОСВЕЩЕНИЕ

scene.add(new THREE.HemisphereLight('#9295df','#171126',.7));

const mainLight=new THREE.DirectionalLight('#c8c8ff',.4);
mainLight.position.set(-5,10,7);
mainLight.castShadow=true;
mainLight.shadow.mapSize.set(2048,2048);
scene.add(mainLight);

const purpleLight=new THREE.PointLight('#7040ff',30,15,2);
purpleLight.position.set(0,2.5,-1);
scene.add(purpleLight);

const blueLight=new THREE.PointLight('#526eff',15,12,2);
blueLight.position.set(3,2,-2);
scene.add(blueLight);

const pinkLight=new THREE.PointLight('#c36bff',8,9,2);
pinkLight.position.set(-3,2,1);
scene.add(pinkLight);

// ПЕРВЫЙ ЭТАЖ: ПОЛ И СТЕНЫ

box(room,0,-.13,0,10,.25,8,M.floor);

const back=box(walls,0,2.6,-4,10,5.2,.15,M.wall);
const front=box(walls,0,2.6,4,10,5.2,.15,M.wall);
const left=box(walls,-5,2.6,0,.15,5.2,8,M.side);
const right=box(walls,5,2.6,0,.15,5.2,8,M.side);

box(walls,0,.12,-3.9,9.8,.18,.09,M.white);
box(walls,-4.9,.12,0,.09,.18,7.8,M.white);
box(walls,4.9,.12,0,.09,.18,7.8,M.white);

strip(room,0,.04,-3.68,9.2,.035,.06,'#7140db');
strip(room,-4.68,.04,0,.06,.035,7.1,'#526dff');
strip(room,4.68,.04,0,.06,.035,7.1,'#7140db');
strip(room,0,.04,3.68,9.2,.035,.06,'#7140db');

// КРОВАТЬ

const bed=group(room,-2.45,0,-1.4);

box(bed,0,.35,0,2.55,.42,3.45,M.wood);
box(bed,0,.61,0,2.43,.18,3.3,M.fabric2);
box(bed,0,.73,.18,2.35,.12,2.75,M.white);
box(bed,0,.83,.53,2.3,.08,1.95,M.fabric);
box(bed,0,.88,1.2,2.34,.12,.65,M.fabric2);
box(bed,0,.62,-1.62,2.55,1.1,.15,M.woodLight);

for(const x of [-1.05,1.05]){
 box(bed,x,.95,-.75,.82,.18,.62,M.white);
 box(bed,x,.96,-.73,.7,.035,.5,M.fabric2);
}

box(bed,-.75,.93,.3,.56,.1,.58,M.pink);

function star(parent,x,y,z,size,color){
 const g=group(parent,x,y,z);
 const m=mat(color);
 ball(g,0,0,0,size*.48,size*.48,.1,m);
 for(let i=0;i<5;i++){
  const a=i*Math.PI*2/5;
  ball(g,Math.cos(a)*size*.58,Math.sin(a)*size*.58,0,
       size*.22,size*.22,.08,m);
 }
}

star(bed,.7,.96,.15,.23,'#e9c2f1');
star(bed,.98,.94,.72,.17,'#a9baff');

// ПЛЮШЕВАЯ АКУЛА

function shark(parent,x,y,z,s=.82){
 const g=group(parent,x,y,z);
 g.scale.setScalar(s);
 const f=mat('#7186a5'),b=mat('#dfe3f0'),fin=mat('#627894');
 const eye=mat('#191a2b');

 ball(g,0,0,0,.72,.32,.3,f);
 ball(g,.02,-.17,.018,.57,.17,.275,b);
 ball(g,.53,.015,0,.32,.25,.29,f);
 ball(g,.78,-.025,0,.22,.14,.17,f);
 ball(g,.78,-.13,.018,.15,.065,.15,mat('#51475d'));
 ball(g,.56,.105,.25,.045,.05,.025,eye);
 ball(g,.56,.105,-.25,.045,.05,.025,eye);

 const finMesh=new THREE.Mesh(
  new THREE.ConeGeometry(.2,.4,4),fin
 );
 finMesh.position.set(-.12,.36,0);
 g.add(finMesh);

 const tail=new THREE.Mesh(
  new THREE.ConeGeometry(.19,.48,4),fin
 );
 tail.position.set(-.82,.2,0);
 tail.rotation.z=-Math.PI/2;
 g.add(tail);
}

shark(bed,-.62,1.05,.38);

// ПЛЮШЕВЫЕ ИГРУШКИ

function teddy(parent,x,y,z,color='#b9a3d7',s=.8){
 const g=group(parent,x,y,z);
 g.scale.setScalar(s);
 const f=mat(color),m=mat('#e6d4dc'),e=mat('#332c47');

 ball(g,0,0,0,.22,.25,.18,f);
 ball(g,0,.27,0,.18,.18,.16,f);
 ball(g,-.135,.4,0,.075,.08,.07,f);
 ball(g,.135,.4,0,.075,.08,.07,f);
 ball(g,0,.22,.14,.095,.07,.045,m);
 ball(g,0,.245,.18,.024,.022,.015,e);
 ball(g,-.06,.3,.14,.018,.02,.012,e);
 ball(g,.06,.3,.14,.018,.02,.012,e);
 ball(g,-.22,-.03,.02,.09,.14,.09,f);
 ball(g,.22,-.03,.02,.09,.14,.09,f);
 ball(g,-.12,-.21,.03,.11,.075,.1,f);
 ball(g,.12,-.21,.03,.11,.075,.1,f);
 ball(g,-.06,.12,.17,.055,.04,.022,M.pink);
 ball(g,.06,.12,.17,.055,.04,.022,M.pink);
}

teddy(bed,-.95,.97,-.25);
teddy(bed,.86,.98,.45,'#d9adb9',.76);

function frog(parent,x,y,z){
 const g=group(parent,x,y,z);
 const f=mat('#789f8b'),e=mat('#29283c');

 ball(g,0,0,0,.24,.17,.19,f);
 ball(g,0,.19,0,.22,.17,.18,f);
 ball(g,-.13,.32,.01,.08,.1,.08,f);
 ball(g,.13,.32,.01,.08,.1,.08,f);
 ball(g,-.13,.34,.11,.018,.025,.014,e);
 ball(g,.13,.34,.11,.018,.025,.014,e);
 ball(g,0,.23,.19,.025,.025,.02,M.violet);
 ball(g,-.06,.23,.17,.045,.035,.025,M.pink);
 ball(g,.06,.23,.17,.045,.035,.025,M.pink);
}

frog(bed,.35,.99,.93);

// ТУМБОЧКА В УГЛУ

const nightstand=group(room,-4.48,0,-3.02);
box(nightstand,0,.65,0,.68,1.3,.68,M.woodLight);
box(nightstand,0,.82,.351,.56,.3,.035,M.white);
box(nightstand,0,.38,.351,.56,.3,.035,M.white);
cyl(nightstand,0,.82,.393,.035,.035,.035,M.metal);
cyl(nightstand,0,.38,.393,.035,.035,.035,M.metal);
box(nightstand,0,1.32,0,.76,.08,.76,M.wood);
cyl(nightstand,0,1.43,0,.07,.07,.16,M.metal);

const shade=new THREE.Mesh(
 new THREE.CylinderGeometry(.17,.25,.25,20),M.glow
);
shade.position.set(0,1.63,0);
nightstand.add(shade);

const lampLight=new THREE.PointLight('#8c63ff',5,4);
lampLight.position.set(-4.48,1.8,-3.02);
scene.add(lampLight);

// ИГРОВОЙ СТОЛ

const desk=group(room,2.45,0,-3.05);
box(desk,0,1.15,0,3.45,.16,1.25,M.woodLight);

for(const x of [-1.45,1.45]){
 box(desk,x,.56,-.4,.13,1.12,.13,M.white);
 box(desk,x,.56,.4,.13,1.12,.13,M.white);
}

box(desk,0,1.05,.53,3.1,.035,.08,M.violet);
box(desk,0,1.98,-.3,1.72,1.05,.11,M.black);

const screenMat=new THREE.MeshBasicMaterial({color:'#718cff'});
box(desk,0,1.98,-.235,1.6,.92,.025,screenMat);
box(desk,-.36,2.15,-.216,.47,.43,.008,mat('#39356f'));
box(desk,.2,1.9,-.215,.58,.55,.008,mat('#35365f'));
box(desk,.55,2.18,-.212,.26,.2,.008,mat('#536eaf'));
box(desk,-.12,1.76,-.207,.8,.012,.008,M.violet);
box(desk,0,1.4,-.3,.1,.3,.1,M.metal);
box(desk,0,1.25,-.3,.48,.06,.28,M.metal);

const monitorGlow=new THREE.PointLight('#6f83ff',22,7,2);
monitorGlow.position.set(2.45,2,-2.45);
scene.add(monitorGlow);

const monitorPurpleGlow=new THREE.PointLight('#9b62ff',10,5,2);
monitorPurpleGlow.position.set(2.1,1.7,-2.1);
scene.add(monitorPurpleGlow);

box(desk,0,1.27,.27,1.12,.055,.36,M.black);

for(let r=0;r<3;r++){
 for(let c=0;c<12;c++){
  box(desk,-.49+c*.09,1.305,.15+r*.09,.055,.012,.045,
      [M.violet,M.blue,M.pink][(c+r)%3],false);
 }
}

box(desk,.95,1.245,.28,.58,.025,.48,M.deep);
ball(desk,.95,1.3,.25,.1,.055,.15,M.white);
box(desk,-1.2,1.38,-.12,.08,.35,.08,M.metal);
box(desk,-1.2,1.57,-.12,.35,.045,.045,M.metal);
ball(desk,-1.37,1.7,-.12,.09,.15,.09,M.black);
box(desk,1.28,1.42,-.08,.055,.3,.055,M.metal);
box(desk,1.28,1.57,-.08,.22,.04,.04,M.metal);

// КРЕСЛО, ПОВЁРНУТОЕ К МОНИТОРУ

const chair=group(room,2.45,0,-1.45);
chair.rotation.y=Math.PI;

cyl(chair,0,.62,0,.1,.1,.9,M.black);
box(chair,0,.87,0,.72,.17,.68,M.black);
